  "allowExceptions": [
    {
      "pattern": "(?i)^(test|render|preview)[A-Za-z]*Interface[A-Za-z]*$",
      "role": "screen",
      "reason": "Renderiza una interfaz con entradas vacias para obtener su arbol de componentes. No hace clic ni envia formularios."
    }
  ],
  "excludePatterns": [
    {
      "pattern": "(?i)record(data|rows?)|rows$|sqlquery|querydata",
      "reason": "Lee filas de datos de negocio (fuera del alcance: solo metadatos y recuentos)."
    },
    {
      "pattern": "(?i)^(list|get|search|find|describe)(all)?users?(detail|details|profile)?$",
      "reason": "Datos personales de usuarios."
    },
    {
      "pattern": "(?i)(password|secret|credential|token)s?$",
      "reason": "Credenciales."
    }
  ],
