<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="P" name="Proceso de prueba" isExecutable="false">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="L_Rev" name="Revisores"><bpmn:flowNodeRef>T_Rev</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_Sis" name="Sistema">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>G</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Ok</bpmn:flowNodeRef><bpmn:flowNodeRef>E</bpmn:flowNodeRef><bpmn:flowNodeRef>E_Err</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Inicio"><bpmn:documentation>nodo 1</bpmn:documentation></bpmn:startEvent>
    <bpmn:userTask id="T_Rev" name="Revisar"/>
    <bpmn:exclusiveGateway id="G" name="¿Aprobada?" default="F_no"/>
    <bpmn:serviceTask id="T_Ok" name="Guardar"/>
    <bpmn:boundaryEvent id="B_Err" attachedToRef="T_Ok"><bpmn:errorEventDefinition/></bpmn:boundaryEvent>
    <bpmn:endEvent id="E" name="Fin"/>
    <bpmn:endEvent id="E_Err" name="Error"/>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="T_Rev"/>
    <bpmn:sequenceFlow id="F2" sourceRef="T_Rev" targetRef="G"/>
    <bpmn:sequenceFlow id="F_si" name="Sí" sourceRef="G" targetRef="T_Ok"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">pv!ok</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_no" name="No" sourceRef="G" targetRef="T_Rev"/>
    <bpmn:sequenceFlow id="F3" sourceRef="T_Ok" targetRef="E"/>
    <bpmn:sequenceFlow id="F4" sourceRef="B_Err" targetRef="E_Err"/>
  </bpmn:process>
</bpmn:definitions>
