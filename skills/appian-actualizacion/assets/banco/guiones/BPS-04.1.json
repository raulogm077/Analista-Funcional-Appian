{
 "escenario": "BPS-04.1",
 "dice": ["Dada una solicitud en borrador de un solicitante",
          "Cuando la envía a aprobación y confirma el envío",
          "Entonces queda pendiente de aprobación"],
 "host": "",
 "site": "",
 "roles": {"solicitante": ""},
 "dado": [
  {"sail": ["load"]},
  {"sail": ["navigate", "Nueva solicitud"]},
  {"sail": ["interact", "Importe", "-5"], "espera": {"texto": ["El importe tiene que ser mayor que cero"]}},
  {"sail": ["interact", "Título", "QA {pasada}", "Importe", "5", "Categoría", "2", "Fecha de inicio", "{hoy}"]},
  {"sail": ["interact", "Crear solicitud"], "espera": {"completado": true}},
  {"sail": ["load"]},
  {"sail": ["interact", "🔍", "QA {pasada}"], "espera": {"fila": {"con": "QA {pasada}", "Estado": "Borrador"}}},
  {"sail": ["navigate", "QA {pasada}"], "espera": {"hay": ["Enviar a aprobación"]}}
 ],
 "cuando": [
  {"sail": ["navigate", "Enviar a aprobación"], "espera": {"texto": ["Confirmar envío"]}},
  {"sail": ["interact", "--confirm", "Comentario para el aprobador", "Recorrido del banco", "Enviar a aprobación"],
   "espera": {"completado": true}}
 ],
 "entonces": [
  {"sail": ["load"]},
  {"sail": ["interact", "🔍", "QA {pasada}"],
   "espera": {"fila": {"con": "QA {pasada}", "Estado": "Pendiente de aprobación"}}}
 ]
}
