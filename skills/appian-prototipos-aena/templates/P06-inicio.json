{
 "id": "inicio",
 "title": "Inicio",
 "type": "page",
 "pattern": "P06",
 "req": [
  "RF-INICIO"
 ],
 "$note": "P06: cabecera de color (saludo, fecha y lo pendiente) + franja de KPI (una card, divisores, sellos de icono, tendencia) + 2X/1X: tareas sin paginación con plazo y «Ver todas»; a la derecha, aviso con acción, accesos rápidos y un gráfico resumen con su tabla alternativa.",
 "local": {
  "local!tablaEstado": false
 },
 "interface": {
  "type": "a!headerContentLayout",
  "backgroundColor": "TRANSPARENT",
  "contents": [
   {
    "type": "a!cardLayout",
    "style": "#1A2732",
    "showBorder": false,
    "shape": "SEMI_ROUNDED",
    "padding": "MORE",
    "marginBelow": "MORE",
    "contents": [
     {
      "type": "a!columnsLayout",
      "alignVertical": "MIDDLE",
      "columns": [
       {
        "type": "a!columnLayout",
        "contents": [
         {
          "type": "a!headingField",
          "text": "Hola, María",
          "size": "LARGE",
          "headingTag": "H1",
          "color": "#FFFFFF",
          "marginBelow": "EVEN_LESS"
         },
         {
          "type": "a!richTextDisplayField",
          "labelPosition": "COLLAPSED",
          "value": [
           {
            "type": "a!richTextItem",
            "text": "Expedientes de su unidad · jueves, 24 de septiembre de 2026",
            "color": "#FFFFFF"
           }
          ],
          "marginBelow": "STANDARD"
         },
         {
          "type": "a!sideBySideLayout",
          "spacing": "SPARSE",
          "alignVertical": "MIDDLE",
          "marginBelow": "NONE",
          "items": [
           {
            "type": "a!sideBySideItem",
            "width": "MINIMIZE",
            "item": {
             "type": "a!richTextDisplayField",
             "labelPosition": "COLLAPSED",
             "value": [
              {
               "type": "a!richTextIcon",
               "icon": "inbox",
               "color": "#FFFFFF"
              },
              " ",
              {
               "type": "a!richTextItem",
               "text": "3",
               "style": "STRONG",
               "color": "#FFFFFF"
              },
              " ",
              {
               "type": "a!richTextItem",
               "text": "tareas pendientes",
               "color": "#FFFFFF"
              }
             ]
            }
           },
           {
            "type": "a!sideBySideItem",
            "width": "MINIMIZE",
            "item": {
             "type": "a!richTextDisplayField",
             "labelPosition": "COLLAPSED",
             "value": [
              {
               "type": "a!richTextIcon",
               "icon": "clock-o",
               "color": "#FFFFFF"
              },
              " ",
              {
               "type": "a!richTextItem",
               "text": "1",
               "style": "STRONG",
               "color": "#FFFFFF"
              },
              " ",
              {
               "type": "a!richTextItem",
               "text": "vence esta semana",
               "color": "#FFFFFF"
              }
             ]
            }
           }
          ]
         }
        ]
       },
       {
        "type": "a!columnLayout",
        "width": "AUTO",
        "contents": [
         {
          "type": "a!buttonArrayLayout",
          "align": "END",
          "marginBelow": "NONE",
          "buttons": [
           {
            "type": "a!buttonWidget",
            "label": "Nuevo expediente",
            "style": "SOLID",
            "color": "#90CE00",
            "icon": "plus",
            "$action": {
             "goto": "asistente"
            }
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "a!cardLayout",
    "style": "NONE",
    "showBorder": false,
    "showShadow": true,
    "shape": "SEMI_ROUNDED",
    "padding": "STANDARD",
    "contents": [
     {
      "type": "a!columnsLayout",
      "showDividers": true,
      "spacing": "SPARSE",
      "stackWhen": [
       "PHONE",
       "TABLET_PORTRAIT"
      ],
      "columns": [
       {
        "type": "a!columnLayout",
        "contents": [
         {
          "type": "a!kpiField",
          "primaryText": "En tramitación",
          "icon": "hourglass-half",
          "template": "ADJACENT",
          "iconStyle": "STAMP",
          "iconColor": "ACCENT",
          "$secondaryValue": 3,
          "secondaryText": "frente al mes anterior",
          "data": "recordType!EXP Expediente",
          "primaryMeasure": {
           "type": "a!measure",
           "function": "COUNT",
           "field": "recordType!EXP Expediente.fields.id"
          },
          "$filter": "fv!row.estado = \"En tramitación\""
         }
        ]
       },
       {
        "type": "a!columnLayout",
        "contents": [
         {
          "type": "a!kpiField",
          "primaryText": "Pendientes de aprobación",
          "icon": "gavel",
          "template": "ADJACENT",
          "iconStyle": "STAMP",
          "iconColor": "ACCENT",
          "$secondaryValue": 5,
          "secondaryText": "frente al mes anterior",
          "trendColor": "REVERSE",
          "data": "recordType!EXP Expediente",
          "primaryMeasure": {
           "type": "a!measure",
           "function": "COUNT",
           "field": "recordType!EXP Expediente.fields.id"
          },
          "$filter": "fv!row.estado = \"Pendiente de aprobación\""
         }
        ]
       },
       {
        "type": "a!columnLayout",
        "contents": [
         {
          "type": "a!kpiField",
          "primaryText": "Importe aprobado",
          "icon": "eur",
          "template": "ADJACENT",
          "iconStyle": "STAMP",
          "iconColor": "ACCENT",
          "$secondaryValue": 828000,
          "secondaryText": "frente al mes anterior",
          "data": "recordType!EXP Expediente",
          "primaryMeasure": {
           "type": "a!measure",
           "function": "SUM",
           "field": "recordType!EXP Expediente.fields.importe"
          },
          "$filter": "fv!row.estado = \"Aprobado\"",
          "$format": "eur"
         }
        ]
       }
      ]
     }
    ],
    "decorativeBarPosition": "TOP",
    "decorativeBarColor": "#90CE00",
    "marginBelow": "MORE"
   },
   {
    "type": "a!columnsLayout",
    "columns": [
     {
      "type": "a!columnLayout",
      "width": "2X",
      "contents": [
       {
        "type": "a!sectionLayout",
        "label": "Mis tareas",
        "labelSize": "MEDIUM",
        "labelHeadingTag": "H2",
        "labelColor": "STANDARD",
        "marginBelow": "MORE",
        "contents": [
         {
          "type": "a!cardLayout",
          "style": "NONE",
          "showBorder": false,
          "showShadow": true,
          "shape": "SEMI_ROUNDED",
          "padding": "STANDARD",
          "contents": [
           {
            "type": "a!gridField",
            "labelPosition": "COLLAPSED",
            "data": "data!tareas",
            "borderStyle": "LIGHT",
            "shadeAlternateRows": false,
            "spacing": "STANDARD",
            "pageSize": 10,
            "rowHeader": 1,
            "emptyGridMessage": "No tiene tareas pendientes",
            "columns": [
             {
              "type": "a!gridColumn",
              "label": "Tarea",
              "value": {
               "type": "a!richTextDisplayField",
               "labelPosition": "COLLAPSED",
               "value": [
                {
                 "type": "a!richTextItem",
                 "text": "Aprobar {fv!row.codigo}",
                 "style": "STRONG",
                 "link": {
                  "type": "a!dynamicLink",
                  "$action": {
                   "goto": "tarea",
                   "params": {
                    "id": "{fv!row.expedienteId}"
                   }
                  }
                 },
                 "linkStyle": "STANDALONE"
                },
                "\n",
                {
                 "type": "a!richTextItem",
                 "text": "{fv!row.titulo}",
                 "color": "SECONDARY",
                 "size": "SMALL"
                }
               ]
              }
             },
             {
              "type": "a!gridColumn",
              "label": "Recibida",
              "value": "{fv!row.recibida|date}",
              "width": "NARROW"
             },
             {
              "type": "a!gridColumn",
              "label": "Plazo",
              "value": {
               "type": "a!tagField",
               "labelPosition": "COLLAPSED",
               "size": "SMALL",
               "tags": [
                {
                 "type": "a!tagItem",
                 "text": "{fv!row.plazo}",
                 "backgroundColor": "{fv!row.urgente|map:plazoColor}"
                }
               ]
              },
              "width": "NARROW_PLUS"
             }
            ],
            "$note": "En Appian: record type de tareas o a!queryProcessAnalytics. 5–10 tareas sin paginación."
           },
           {
            "type": "a!richTextDisplayField",
            "labelPosition": "COLLAPSED",
            "align": "RIGHT",
            "marginAbove": "LESS",
            "value": [
             {
              "type": "a!richTextItem",
              "text": "Ver todas",
              "link": {
               "type": "a!dynamicLink",
               "$action": {
                "goto": "maestro"
               }
              },
              "linkStyle": "STANDALONE",
              "style": "STRONG"
             },
             " ",
             {
              "type": "a!richTextIcon",
              "icon": "arrow-right",
              "color": "ACCENT",
              "link": {
               "type": "a!dynamicLink",
               "$action": {
                "goto": "maestro"
               }
              },
              "altText": "Ver todas"
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     },
     {
      "type": "a!columnLayout",
      "contents": [
       {
        "type": "a!cardLayout",
        "style": "WARN",
        "showBorder": false,
        "padding": "STANDARD",
        "shape": "SEMI_ROUNDED",
        "decorativeBarPosition": "START",
        "decorativeBarColor": "WARN",
        "marginBelow": "MORE",
        "contents": [
         {
          "type": "a!sideBySideLayout",
          "alignVertical": "MIDDLE",
          "spacing": "STANDARD",
          "items": [
           {
            "type": "a!sideBySideItem",
            "width": "MINIMIZE",
            "item": {
             "type": "a!richTextDisplayField",
             "labelPosition": "COLLAPSED",
             "value": [
              {
               "type": "a!richTextIcon",
               "icon": "clock-o",
               "color": "WARN",
               "size": "MEDIUM"
              }
             ]
            }
           },
           {
            "type": "a!sideBySideItem",
            "item": {
             "type": "a!richTextDisplayField",
             "labelPosition": "COLLAPSED",
             "value": [
              {
               "type": "a!richTextItem",
               "text": "EXP-2026-0002: vence en 2 días",
               "style": "STRONG"
              },
              "\n",
              "Si no se resuelve a tiempo, la tarea se escala a su responsable"
             ]
            }
           },
           {
            "type": "a!sideBySideItem",
            "width": "MINIMIZE",
            "item": {
             "type": "a!buttonArrayLayout",
             "marginBelow": "NONE",
             "buttons": [
              {
               "type": "a!buttonWidget",
               "label": "Revisar",
               "style": "OUTLINE",
               "color": "ACCENT",
               "$action": {
                "goto": "tarea",
                "params": {
                 "id": 2
                }
               },
               "size": "SMALL"
              }
             ]
            }
           }
          ]
         }
        ]
       },
       {
        "type": "a!sectionLayout",
        "label": "Accesos rápidos",
        "labelSize": "MEDIUM",
        "labelHeadingTag": "H2",
        "labelColor": "STANDARD",
        "marginBelow": "MORE",
        "contents": [
         {
          "type": "a!cardLayout",
          "style": "NONE",
          "showBorder": false,
          "showShadow": true,
          "shape": "SEMI_ROUNDED",
          "padding": "STANDARD",
          "contents": [
           {
            "type": "a!recordActionField",
            "style": "CARDS",
            "display": "LABEL_AND_ICON",
            "actions": [
             {
              "type": "a!recordActionItem",
              "action": "recordType!EXP Expediente.actions.altaDesdeSolicitud",
              "$label": "Alta desde solicitud escaneada",
              "$icon": "magic",
              "$action": {
               "goto": "revision-ia"
              }
             },
             {
              "type": "a!recordActionItem",
              "action": "recordType!EXP Expediente.actions.altaRapida",
              "$label": "Alta rápida (una página)",
              "$icon": "bolt",
              "$action": {
               "goto": "formulario"
              }
             }
            ]
           }
          ]
         }
        ],
        "$note": "Otras acciones del registro; la principal («Nuevo expediente») ya está en la cabecera y no se repite."
       },
       {
        "type": "a!sectionLayout",
        "label": "Por estado",
        "labelSize": "MEDIUM",
        "labelHeadingTag": "H2",
        "labelColor": "STANDARD",
        "marginBelow": "MORE",
        "contents": [
         {
          "type": "a!cardLayout",
          "style": "NONE",
          "showBorder": false,
          "showShadow": true,
          "shape": "SEMI_ROUNDED",
          "padding": "STANDARD",
          "contents": [
           {
            "type": "a!sectionLayout",
            "marginBelow": "NONE",
            "contents": [
             {
              "type": "a!richTextDisplayField",
              "labelPosition": "COLLAPSED",
              "value": [
               {
                "type": "a!richTextIcon",
                "icon": "{if(local!tablaEstado, \"bar-chart\", \"table\")}",
                "color": "ACCENT"
               },
               " ",
               {
                "type": "a!richTextItem",
                "text": "{if(local!tablaEstado, \"Ver como gráfico\", \"Ver como tabla\")}",
                "link": {
                 "type": "a!dynamicLink",
                 "saveInto": [
                  {
                   "type": "a!save",
                   "target": "local!tablaEstado",
                   "value": "{not(local!tablaEstado)}"
                  }
                 ]
                },
                "linkStyle": "STANDALONE",
                "style": "STRONG"
               }
              ],
              "align": "RIGHT",
              "marginBelow": "LESS"
             },
             {
              "type": "a!barChartField",
              "labelPosition": "COLLAPSED",
              "data": "recordType!EXP Expediente",
              "height": "AUTO",
              "showDataLabels": true,
              "$categories": [
               "Borrador",
               "En tramitación",
               "Pendiente de aprobación",
               "Aprobado",
               "Cerrado",
               "Rechazado"
              ],
              "config": {
               "type": "a!barChartConfig",
               "primaryGrouping": {
                "type": "a!grouping",
                "field": "recordType!EXP Expediente.fields.estado"
               },
               "secondaryGrouping": {
                "type": "a!grouping",
                "field": "recordType!EXP Expediente.fields.estado"
               },
               "measures": [
                {
                 "type": "a!measure",
                 "function": "COUNT",
                 "field": "recordType!EXP Expediente.fields.id",
                 "label": "Expedientes"
                }
               ]
              },
              "stacking": "NORMAL",
              "showLegend": false,
              "colorScheme": {
               "type": "a!colorSchemeCustom",
               "colors": [
                "#525C65",
                "#1A2732",
                "#9A5200",
                "#0E6B00",
                "#525C65",
                "#B2002C"
               ]
              },
              "showWhen": "not(local!tablaEstado)"
             },
             {
              "type": "a!gridField",
              "labelPosition": "COLLAPSED",
              "borderStyle": "LIGHT",
              "shadeAlternateRows": false,
              "spacing": "STANDARD",
              "pageSize": 20,
              "rowHeader": 1,
              "emptyGridMessage": "No hay datos que mostrar",
              "columns": [
               {
                "type": "a!gridColumn",
                "label": "Estado",
                "value": "{fv!row.categoria}"
               },
               {
                "type": "a!gridColumn",
                "label": "Expedientes",
                "value": "{fv!row.s1|num}",
                "align": "END"
               }
              ],
              "$chart": {
               "type": "a!barChartField",
               "labelPosition": "COLLAPSED",
               "data": "recordType!EXP Expediente",
               "height": "AUTO",
               "showDataLabels": true,
               "$categories": [
                "Borrador",
                "En tramitación",
                "Pendiente de aprobación",
                "Aprobado",
                "Cerrado",
                "Rechazado"
               ],
               "config": {
                "type": "a!barChartConfig",
                "primaryGrouping": {
                 "type": "a!grouping",
                 "field": "recordType!EXP Expediente.fields.estado"
                },
                "secondaryGrouping": {
                 "type": "a!grouping",
                 "field": "recordType!EXP Expediente.fields.estado"
                },
                "measures": [
                 {
                  "type": "a!measure",
                  "function": "COUNT",
                  "field": "recordType!EXP Expediente.fields.id",
                  "label": "Expedientes"
                 }
                ]
               },
               "stacking": "NORMAL",
               "showLegend": false,
               "colorScheme": {
                "type": "a!colorSchemeCustom",
                "colors": [
                 "#525C65",
                 "#1A2732",
                 "#9A5200",
                 "#0E6B00",
                 "#525C65",
                 "#B2002C"
                ]
               }
              },
              "$note": "En Appian: a!gridField sobre a!queryRecordType con a!aggregationFields (la misma agrupación, medidas y filtros que el gráfico).",
              "showWhen": "local!tablaEstado"
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   }
  ]
 }
}