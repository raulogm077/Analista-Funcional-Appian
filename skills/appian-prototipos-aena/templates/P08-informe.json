                  "type": "a!measure",
                  "function": "COUNT",
                  "field": "recordType!EXP Expediente.fields.id",
                  "label": "Expedientes"
                 }
                ],
                "link": {
                 "type": "a!dynamicLink",
                 "saveInto": [
                  {
                   "type": "a!save",
                   "target": "local!estadoSel",
                   "value": "{fv!selection[recordType!EXP Expediente.fields.estado]}"
                  }
                 ]
                }
               },
               "stacking": "NORMAL",
               "showLegend": false,
               "colorScheme": {
                "type": "a!colorSchemeCustom",
                "colors": [
                 "#525C65",
                 "#1A2732",
                 "#9A5200",
                 "#0E6B00",
                 "#525C65",
                 "#B2002C"
                ]
               }
              },
              "$note": "En Appian: a!gridField sobre a!queryRecordType con a!aggregationFields (la misma agrupación, medidas y filtros que el gráfico).",
              "showWhen": "local!tablaEstado"
             }
            ]
           },
           {
            "type": "a!sectionLayout",
            "showWhen": "a!isNotNullOrEmpty(local!estadoSel)",
