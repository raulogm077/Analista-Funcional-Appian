               },
               {
                "type": "a!gridColumn",
                "label": "Unidad",
                "value": "{fv!row.unidad}",
                "width": "NARROW"
               },
               {
                "type": "a!gridColumn",
                "label": "Importe",
                "value": "{fv!row.importe|eur|dash}",
                "align": "END",
                "width": "NARROW_PLUS"
               }
              ],
              "$filter": "and(and(or(isnull(local!tipo), fv!row.tipo = local!tipo), or(isnull(local!unidad), fv!row.unidad = local!unidad)), fv!row.estado = local!estadoSel)"
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   }
  ]
 }
}