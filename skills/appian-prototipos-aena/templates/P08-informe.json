             {
              "type": "a!gridField",
              "labelPosition": "COLLAPSED",
              "data": "recordType!EXP Expediente",
              "borderStyle": "LIGHT",
              "shadeAlternateRows": false,
              "spacing": "STANDARD",
              "pageSize": 5,
              "rowHeader": 1,
              "emptyGridMessage": "No hay expedientes",
              "columns": [
               {
                "type": "a!gridColumn",
                "label": "Expediente",
                "value": {
                 "type": "a!richTextDisplayField",
                 "labelPosition": "COLLAPSED",
                 "value": [
                  {
                   "type": "a!richTextItem",
                   "text": "{fv!row.codigo}",
                   "style": "STRONG",
