            "SECONDARY"
          ],
          "default": "STANDARD",
          "acceptsHexColors": true
        },
        "backgroundColor": {
          "type": "Text",
          "description": "Title bar background. Valid: hex (with optional transparency 00-FF) or ACCENT/WHITE/CHARCOAL_SCHEME/NAVY_SCHEME/PLUM_SCHEME.",
          "validValues": [
            "ACCENT",
            "WHITE",
            "CHARCOAL_SCHEME",
            "NAVY_SCHEME",
            "PLUM_SCHEME"
          ],
          "default": "ACCENT",
          "acceptsHexColors": true,
          "supportsTransparency": true
        },
        "image": {
