{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "SAIL Layout Components - Page structure and container components",
  "version": "2.4.0",
  "sharedParameters": {
    "universalLayouts": {
      "description": "Parameters common to all layout components",
      "showWhen": {
        "type": "Boolean",
        "default": true,
        "description": "Determines whether the layout is displayed on the interface"
      }
    }
  },
  "components": {
    "a!formLayout": {
      "description": "Top-level form layout with optional header, contents, and buttons",
      "category": "layout",
      "inherits": [
        "universalLayouts"
      ],
      "parameters": {
        "titleBar": {
          "type": "Text|CardLayout|HeaderTemplate"
        },
        "isTitleBarFixed": {
          "type": "Boolean",
          "default": false,
          "description": "Default: false (true in dialogs)"
        },
        "showTitleBarDivider": {
          "type": "Boolean",
          "default": false,
          "description": "Default: false (true in dialogs)"
        },
        "backgroundColor": {
          "type": "Text",
          "validValues": [
            "WHITE",
            "TRANSPARENT",
            "CHARCOAL_SCHEME",
            "NAVY_SCHEME",
            "PLUM_SCHEME"
          ],
          "acceptsHexColors": true,
          "default": "WHITE",
          "supportsTransparency": true
        },
        "contents": {
          "type": "Any Type Array"
        },
        "contentsWidth": {
          "type": "Text",
          "validValues": [
            "EXTRA_NARROW",
            "NARROW",
            "MEDIUM",
            "WIDE",
            "FULL"
          ],
          "default": "NARROW"
        },
        "focusOnFirstInput": {
          "type": "Boolean",
          "default": true
        },
        "buttons": {
          "type": "Button Layout"
        },
        "isButtonFooterFixed": {
          "type": "Boolean",
          "default": false,
          "description": "Default: false (true in dialogs)"
        },
        "showButtonDivider": {
          "type": "Boolean",
          "default": false,
          "description": "Default: false (true in dialogs)"
        },
        "validations": {
          "type": "Text/Validation Message"
        },
        "validationGroup": {
          "type": "Text/Validation Message Array"
        }
      }
    },
    "a!headerContentLayout": {
      "description": "General purpose page layout with header (optional) and content sections",
      "category": "layout",
      "inherits": [
        "universalLayouts"
      ],
      "parameters": {
        "header": {
          "type": "Any Type",
          "description": "Billboard, card, or list of billboards/cards"
        },
        "contents": {
          "type": "Any Type Array"
        },
        "backgroundColor": {
          "type": "Text",
          "validValues": [
            "WHITE",
            "TRANSPARENT",
            "CHARCOAL_SCHEME",
            "NAVY_SCHEME",
            "PLUM_SCHEME"
          ],
          "acceptsHexColors": true,
          "default": "WHITE",
          "supportsTransparency": true
        },
        "contentsPadding": {
          "type": "Text",
          "validValues": [
            "NONE",
            "EVEN_LESS",
            "LESS",
            "STANDARD",
            "MORE",
            "EVEN_MORE"
          ],
          "default": "STANDARD"
        },
        "isHeaderFixed": {
          "type": "Boolean",
          "description": "Whether header stays at top when scrolling. Ignored when a pane layout is used in contents",
          "default": false
        }
      }
    },
    "a!paneLayout": {
      "category": "layout",
      "inherits": [
        "universalLayouts"
      ],
      "parameters": {
        "panes": {
          "type": "List of a!pane",
          "required": true,
          "description": "List of two or three a!pane() components to display in the pane layout"
        },
        "showPaneDividers": {
          "type": "Boolean",
          "default": true
        }
      },
      "specialNote": "At least one pane should use width: \"AUTO\" for fluid layout. An interface can only contain one pane layout; it cannot be nested inside another pane layout or placed next to other components (only valid inside a!formLayout or a!headerContentLayout, or as top-level layout)",
      "description": "2-3 full-height vertical panes with independent scrolling"
    },
    "a!pane": {
      "category": "layout",
      "inherits": [
        "universalLayouts"
      ],
      "parameters": {
        "contents": {
          "type": "Any Type"
        },
        "width": {
          "type": "Text",
          "validValues": [
            "AUTO",
            "EXTRA_NARROW",
            "NARROW",
            "NARROW_PLUS",
            "MEDIUM",
            "MEDIUM_PLUS",
            "WIDE",
            "WIDE_PLUS"
          ],
          "default": "AUTO"
        },
        "backgroundColor": {
          "type": "Text",
          "acceptsHexColors": true,
          "validValues": [
            "WHITE",
            "GRAY",
            "TRANSPARENT",
            "CHARCOAL_SCHEME",
            "NAVY_SCHEME",
            "PLUM_SCHEME"
          ],
          "default": "WHITE",
          "supportsTransparency": true
        },
        "padding": {
          "type": "Text",
          "validValues": [
            "NONE",
            "EVEN_LESS",
            "LESS",
            "STANDARD",
            "MORE",
            "EVEN_MORE"
          ],
          "default": "STANDARD"
        },
        "accessibilityText": {
          "type": "Text",
          "description": "Additional text announced by screen readers. Each pane must include a unique accessibilityText value briefly describing its content"
        }
      },
      "description": "Individual pane within paneLayout"
    },
    "a!wizardLayout": {
      "category": "layout",
      "inherits": [
        "universalLayouts"
      ],
      "parameters": {
        "titleBar": {
          "type": "Text|CardLayout|HeaderTemplate"
        },
        "isTitleBarFixed": {
          "type": "Boolean",
          "default": false,
          "description": "Default: false (true in dialogs)"
        },
        "showTitleBarDivider": {
          "type": "Boolean",
          "default": false,
          "description": "Default: false (true in dialogs)"
        },
        "backgroundColor": {
          "type": "Text",
          "validValues": [
            "WHITE",
            "TRANSPARENT",
            "CHARCOAL_SCHEME",
            "NAVY_SCHEME",
            "PLUM_SCHEME"
          ],
          "acceptsHexColors": true,
          "default": "WHITE"
        },
        "steps": {
          "type": "List of a!wizardStep",
          "required": true
        },
        "style": {
          "type": "Text",
          "validValues": [
            "DOT_VERTICAL",
            "DOT_HORIZONTAL",
            "CHEVRON_VERTICAL",
            "CHEVRON_HORIZONTAL",
            "LINE_VERTICAL",
            "LINE_HORIZONTAL",
            "MINIMAL"
          ],
          "default": "DOT_VERTICAL"
        },
        "contentsWidth": {
          "type": "Text",
          "validValues": [
            "EXTRA_NARROW",
            "NARROW",
            "MEDIUM",
            "WIDE",
            "FULL"
          ],
          "default": "FULL"
        },
        "showStepHeadings": {
          "type": "Boolean",
          "default": true
        },
        "focusOnFirstInput": {
          "type": "Boolean",
          "default": true
        },
        "primaryButtons": {
          "type": "List of ButtonWidget"
        },
        "secondaryButtons": {
          "type": "List of ButtonWidget"
        },
        "isButtonFooterFixed": {
          "type": "Boolean",
          "default": false,
          "description": "Default: false (true in dialogs)"
        },
        "showButtonDivider": {
          "type": "Boolean",
          "default": false,
          "description": "Default: false (true in dialogs)"
        }
      },
      "description": "Multi-step form layout with automatic navigation and progress indicators"
    },
    "a!wizardStep": {
      "category": "layout",
      "inherits": [
        "universalLayouts"
      ],
      "parameters": {
        "label": {
          "type": "Text",
          "required": true
        },
        "instructions": {
          "type": "Text",
          "description": "Optional text to display below the heading for the wizard step"
        },
        "contents": {
          "type": "Any Type",
          "required": true
        },
        "disableNextButton": {
          "type": "Boolean",
          "default": false
        },
        "validations": {
          "type": "List of Variant",
          "description": "Text array or mix of text and a!validationMessage(), displayed above the buttons"
        },
        "validationGroup": {
          "type": "Text",
          "description": "Keyword identifying the validation group; validations only evaluated when a button with the same group is selected. No spaces"
        }
      },
      "description": "Individual step within wizardLayout"
    },
    "a!boxLayout": {
      "category": "layout",
      "inherits": [
        "universalLayouts"
      ],
      "parameters": {
        "label": {
          "type": "Text",
          "description": "Box title"
        },
        "contents": {
          "type": "Any Type Array"
        },
        "style": {
          "type": "Text",
          "validValues": [
            "STANDARD",
            "ACCENT",
            "SUCCESS",
            "INFO",
            "WARN",
            "ERROR"
          ],
          "acceptsHexColors": true,
          "default": "STANDARD",
          "supportsTransparency": true
        },
        "isCollapsible": {
          "type": "Boolean",
          "default": false
        },
        "isInitiallyCollapsed": {
          "type": "Boolean",
          "default": false
        },
        "accessibilityText": {
          "type": "Text"
        },
        "padding": {
          "type": "Text",
          "validValues": [
            "NONE",
            "EVEN_LESS",
            "LESS",
            "STANDARD",
            "MORE",
            "EVEN_MORE"
          ],
          "default": "LESS"
        },
        "shape": {
          "type": "Text",
          "validValues": [
            "SQUARED",
            "SEMI_ROUNDED",
            "ROUNDED"
          ],
          "default": "SQUARED"
        },
        "showBorder": {
          "type": "Boolean",
          "default": true
        },
        "showShadow": {
          "type": "Boolean",
          "default": false
        },
        "labelSize": {
          "type": "Text",
          "validValues": [
            "LARGE_PLUS",
            "LARGE",
            "MEDIUM_PLUS",
            "MEDIUM",
            "SMALL",
            "EXTRA_SMALL"
          ],
          "default": "EXTRA_SMALL"
        },
        "labelHeadingTag": {
          "type": "Text",
          "validValues": [
            "H1",
            "H2",
            "H3",
            "H4",
            "H5",
            "H6"
          ],
          "description": "Dependent on label size"
        },
        "marginAbove": {
          "type": "Text",
          "validValues": [
            "NONE",
            "EVEN_LESS",
            "LESS",
            "STANDARD",
            "MORE",
            "EVEN_MORE"
          ],
          "default": "NONE"
        },
        "marginBelow": {
          "type": "Text",
          "validValues": [
            "NONE",
            "EVEN_LESS",
            "LESS",
            "STANDARD",
            "MORE",
            "EVEN_MORE"
          ],
          "default": "NONE"
        }
      },
      "description": "Content within a box outline with a title bar"
    },
    "a!columnsLayout": {
      "category": "layout",
      "inherits": [
        "universalLayouts"
      ],
      "parameters": {
        "columns": {
          "type": "List of columnLayout",
          "required": true
        },
        "alignVertical": {
          "type": "Text",
          "validValues": [
            "TOP",
            "MIDDLE",
            "BOTTOM"
          ],
          "default": "TOP"
        },
        "spacing": {
          "type": "Text",
          "validValues": [
            "STANDARD",
            "NONE",
            "DENSE",
            "SPARSE"
          ],
          "default": "STANDARD"
        },
        "showDividers": {
          "type": "Boolean",
          "default": false
        },
        "stackWhen": {
          "type": "List of Text",
          "validValues": [
            "PHONE",
            "TABLET_PORTRAIT",
            "TABLET_LANDSCAPE",
            "DESKTOP",
            "DESKTOP_WIDE",
            "NEVER"
          ],
          "default": "PHONE"
        },
        "marginAbove": {
          "type": "Text",
          "validValues": [
            "NONE",
            "EVEN_LESS",
            "LESS",
            "STANDARD",
            "MORE",
            "EVEN_MORE"
          ],
          "default": "NONE"
        },
        "marginBelow": {
          "type": "Text",
          "validValues": [
            "NONE",
            "EVEN_LESS",
            "LESS",
            "STANDARD",
            "MORE",
            "EVEN_MORE"
          ],
          "default": "STANDARD"
        }
      },
      "specialNote": "At least one column must have width: \"AUTO\" for proper layout distribution",
      "description": "Horizontal column arrangement"
    },
    "a!columnLayout": {
      "category": "layout",
      "inherits": [
        "universalLayouts"
      ],
      "parameters": {
        "contents": {
          "type": "Any Type"
        },
        "width": {
          "type": "Text",
          "validValues": [
            "AUTO",
            "EXTRA_NARROW",
            "NARROW",
            "NARROW_PLUS",
            "MEDIUM",
            "MEDIUM_PLUS",
            "WIDE",
            "WIDE_PLUS",
            "EXTRA_WIDE",
            "1X",
            "2X",
            "3X",
            "4X",
            "5X",
            "6X",
            "7X",
            "8X",
            "9X",
            "10X"
          ],
          "default": "AUTO"
        }
      },
      "description": "Single column within columns layout"
    },
    "a!sideBySideLayout": {
      "category": "layout",
      "inherits": [
        "universalLayouts"
      ],
      "parameters": {
        "items": {
          "type": "List of sideBySideItem",
          "required": true
        },
        "alignVertical": {
          "type": "Text",
          "validValues": [
            "TOP",
            "MIDDLE",
            "BOTTOM"
          ],
          "default": "TOP"
        },
        "spacing": {
          "type": "Text",
          "validValues": [
            "STANDARD",
            "NONE",
            "DENSE",
            "SPARSE"
          ],
          "default": "STANDARD"
        },
        "stackWhen": {
          "type": "List of Text",
          "validValues": [
            "PHONE",
            "TABLET_PORTRAIT",
            "TABLET_LANDSCAPE",
            "DESKTOP_NARROW",
            "DESKTOP",
            "DESKTOP_WIDE",
            "NEVER"
          ],
          "default": "NEVER"
        },
        "marginAbove": {
          "type": "Text",
          "validValues": [
            "NONE",
            "EVEN_LESS",
            "LESS",
            "STANDARD",
            "MORE",
            "EVEN_MORE"
          ],
          "default": "NONE"
        },
        "marginBelow": {
          "type": "Text",
          "validValues": [
            "NONE",
            "EVEN_LESS",
            "LESS",
            "STANDARD",
            "MORE",
            "EVEN_MORE"
          ],
          "default": "STANDARD"
        }
      },
      "specialNote": "Since Appian 26.1, nesting a!sideBySideLayout inside a!sideBySideItem is officially valid and items accept lists of components. Moderation: keep nesting to one level maximum; use a!columnsLayout for complex structures. Layouts other than a!sideBySideLayout (columnsLayout, cardLayout), grids, and a!eventHistoryListField are still NOT allowed inside sideBySideItems",
      "description": "Side-by-side component arrangement (like flex)"
    },
    "a!sideBySideItem": {
      "category": "layout",
      "inherits": [
        "universalLayouts"
      ],
      "parameters": {
        "item": {
          "type": "List of components",
          "required": true,
          "description": "List of components to display inside the layout. Supports side by side layouts and most input, selection, display, action, chart, and picker components"
        },
        "width": {
          "type": "Text",
          "validValues": [
            "AUTO",
            "MINIMIZE",
            "1X",
            "2X",
            "3X",
            "4X",
            "5X",
            "6X",
            "7X",
            "8X",
            "9X",
            "10X"
          ],
          "default": "AUTO"
        }
      },
      "specialNote": "The item parameter accepts a list of components, including a nested a!sideBySideLayout (valid since Appian 26.1). NOT supported: layouts other than a!sideBySideLayout (columnsLayout, cardLayout), read-only/editable grids (a!gridField, a!gridLayout), a!eventHistoryListField, and browser components. Moderation: keep side-by-side nesting to one level",
      "description": "Item within side-by-side layout"
    },
    "a!cardLayout": {
      "category": "layout",
      "inherits": [
        "universalLayouts"
      ],
      "parameters": {
        "contents": {
          "type": "Any Type"
        },
        "link": {
          "type": "Any Type",
          "description": "Link to apply to the card. Create with a!documentDownloadLink(), a!dynamicLink(), a!newsEntryLink(), a!processTaskLink(), a!recordLink(), a!reportLink(), a!safeLink(), a!startProcessLink(), a!submitLink(), a!userRecordLink(), or a!authorizationLink()"
        },
        "height": {
          "type": "Text",
          "validValues": [
            "EXTRA_SHORT",
            "SHORT",
            "SHORT_PLUS",
            "MEDIUM",
            "MEDIUM_PLUS",
            "TALL",
            "TALL_PLUS",
            "EXTRA_TALL",
            "AUTO"
          ],
          "default": "AUTO"
        },
        "style": {
          "type": "Text",
          "validValues": [
            "NONE",
            "TRANSPARENT",
            "STANDARD",
            "ACCENT",
            "SUCCESS",
            "INFO",
            "WARN",
            "ERROR",
            "CHARCOAL_SCHEME",
            "NAVY_SCHEME",
            "PLUM_SCHEME"
          ],
          "acceptsHexColors": true,
          "supportsTransparency": true,
          "description": "Card background color. Accepts enumerated values or hex colors with optional alpha channel for transparency (#RRGGBBAA where AA is 00-FF)",
          "default": "NONE"
        },
        "shape": {
          "type": "Text",
          "validValues": [
            "SQUARED",
            "SEMI_ROUNDED",
            "ROUNDED"
          ],
          "default": "SQUARED",
          "description": "Determines the card shape (corner rounding)."
        },
        "padding": {
          "type": "Text",
          "validValues": [
            "NONE",
            "EVEN_LESS",
            "LESS",
            "STANDARD",
            "MORE",
            "EVEN_MORE"
          ],
          "default": "LESS"
        },
        "showBorder": {
          "type": "Boolean",
          "default": true
        },
        "showShadow": {
          "type": "Boolean",
          "default": false
        },
        "tooltip": {
          "type": "Text",
          "description": "Text to display on mouseover"
        },
        "decorativeBarPosition": {
          "type": "Text",
          "validValues": [
            "NONE",
            "TOP",
            "BOTTOM",
            "START",
            "END"
          ],
          "default": "NONE"
        },
        "decorativeBarColor": {
          "type": "Text",
          "validValues": [
            "ACCENT",
            "POSITIVE",
            "WARN",
            "NEGATIVE",
            "INFO"
          ],
          "acceptsHexColors": true,
          "supportsTransparency": true,
          "default": "ACCENT",
          "description": "Decorative bar color. Any valid hex color (optionally with transparency: #RRGGBBAA) or enumerated value."
        },
        "borderColor": {
          "type": "Text",
          "validValues": [
            "STANDARD",
            "ACCENT",
            "POSITIVE",
            "WARN",
            "NEGATIVE",
            "INFO"
          ],
          "acceptsHexColors": true,
          "supportsTransparency": true,
          "default": "STANDARD",
          "description": "Border color. Any valid hex color (optionally with transparency: #RRGGBBAA) or enumerated value."
        },
        "accessibilityText": {
          "type": "Text"
        },
        "marginAbove": {
          "type": "Text",
          "validValues": [
            "NONE",
            "EVEN_LESS",
            "LESS",
            "STANDARD",
            "MORE",
            "EVEN_MORE"
          ],
          "default": "NONE"
        },
        "marginBelow": {
          "type": "Text",
          "validValues": [
            "NONE",
            "EVEN_LESS",
            "LESS",
            "STANDARD",
            "MORE",
            "EVEN_MORE"
          ],
          "default": "NONE"
        }
      },
      "description": "Content within a styled card with optional border, shadow, and background color"
    },
    "a!cardGroupLayout": {
      "category": "layout",
      "inherits": [
        "universalLayouts"
      ],
      "parameters": {
        "label": {
          "type": "Text",
          "description": "Text to display as the field label"
        },
        "labelPosition": {
          "type": "Text",
          "validValues": [
            "ABOVE",
            "ADJACENT",
            "COLLAPSED",
            "JUSTIFIED"
          ],
          "default": "COLLAPSED"
        },
        "helpTooltip": {
          "type": "Text",
          "description": "Help icon tooltip text. Not shown when labelPosition is COLLAPSED"
        },
        "cards": {
          "type": "Any Type"
        },
        "spacing": {
          "type": "Text",
          "validValues": [
            "STANDARD",
            "NONE",
            "DENSE",
            "SPARSE"
          ],
          "default": "STANDARD"
        },
        "cardWidth": {
          "type": "Text",
          "validValues": [
            "EXTRA_NARROW",
            "NARROW",
            "NARROW_PLUS",
            "MEDIUM",
            "MEDIUM_PLUS",
            "WIDE",
            "WIDE_PLUS",
            "EXTRA_WIDE"
          ],
          "default": "MEDIUM"
        },
        "fillContainer": {
          "type": "Boolean",
          "default": true,
          "description": "When true (default), card widths expand so the group fills the container; when false, cards have a fixed width. Cards in a group always have matching widths"
        },
        "cardHeight": {
          "type": "Text",
          "validValues": [
            "AUTO",
            "EXTRA_SHORT",
            "SHORT",
            "SHORT_PLUS",
            "MEDIUM",
            "MEDIUM_PLUS",
            "TALL",
            "TALL_PLUS",
            "EXTRA_TALL"
          ],
          "default": "AUTO"
        },
        "marginAbove": {
          "type": "Text",
          "validValues": [
            "NONE",
            "EVEN_LESS",
            "LESS",
            "STANDARD",
            "MORE",
            "EVEN_MORE"
          ],
          "default": "NONE"
        },
        "marginBelow": {
          "type": "Text",
          "validValues": [
            "NONE",
            "EVEN_LESS",
            "LESS",
            "STANDARD",
            "MORE",
            "EVEN_MORE"
          ],
          "default": "MORE"
        }
      },
      "description": "Group of cards with automatic responsive flow"
    },
    "a!sectionLayout": {
      "category": "layout",
      "inherits": [
        "universalLayouts"
      ],
      "parameters": {
        "label": {
          "type": "Text",
          "description": "Section heading"
        },
        "contents": {
          "type": "Any Type"
        },
        "validations": {
          "type": "List of Variant"
        },
        "validationGroup": {
          "type": "Text",
          "description": "Text without spaces"
        },
        "isCollapsible": {
          "type": "Boolean",
          "default": false,
          "description": "When true, users can click a caret to expand/collapse section contents"
        },
        "isInitiallyCollapsed": {
          "type": "Boolean",
          "default": false
        },
        "accessibilityText": {
          "type": "Text"
        },
        "labelIcon": {
          "type": "Text",
          "description": "Icon names"
        },
        "iconAltText": {
          "type": "Text"
        },
        "labelSize": {
          "type": "Text",
          "validValues": [
            "LARGE_PLUS",
            "LARGE",
            "MEDIUM_PLUS",
            "MEDIUM",
            "SMALL",
            "EXTRA_SMALL"
          ],
          "default": "MEDIUM"
        },
        "labelHeadingTag": {
          "type": "Text",
          "validValues": [
            "H1",
            "H2",
            "H3",
