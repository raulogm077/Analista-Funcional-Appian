{
 "id": "ia",
 "title": "Asistente del expediente",
 "type": "page",
 "pattern": "P11",
 "req": [
  "RF-FICHA"
 ],
 "$note": "P11: solo si el análisis pide IA (si no, propuesta con $assumption). Chat del agente en una card sin relleno y, al lado, lo que propone en campos editables que el usuario revisa y guarda (outputsSaveInto); aviso de fiabilidad y valoración. Variantes: a página completa (height FILL), documento + chat (ai_doc_chat) y chat de datos en panel (ai_side_pane). Reglas en design-rules.md §14.",
 "local": {
  "local!borrador": null,
  "local!valoracion": null
 },
 "$assumption": "Propuesta: asistente de IA para redactar el informe de tramitación (no está en los requisitos).",
 "interface": {
  "type": "a!headerContentLayout",
  "backgroundColor": "TRANSPARENT",
  "contents": [
   {
    "type": "a!columnsLayout",
    "alignVertical": "MIDDLE",
    "marginBelow": "MORE",
    "columns": [
     {
      "type": "a!columnLayout",
      "contents": [
       {
        "type": "a!headingField",
        "text": "Informes de tramitación",
        "size": "LARGE",
        "headingTag": "H1",
        "marginBelow": "EVEN_LESS"
       },
       {
        "type": "a!richTextDisplayField",
        "labelPosition": "COLLAPSED",
        "value": [
         {
          "type": "a!richTextItem",
          "text": "Pida al asistente un borrador del informe de un expediente y revíselo antes de guardarlo",
          "color": "SECONDARY"
         }
        ],
        "marginBelow": "NONE"
       }
      ]
     }
    ]
   },
   {
    "type": "a!columnsLayout",
    "columns": [
     {
      "type": "a!columnLayout",
      "contents": [
       {
        "type": "a!cardLayout",
        "style": "NONE",
        "showBorder": false,
        "showShadow": true,
        "shape": "SEMI_ROUNDED",
        "padding": "NONE",
        "contents": [
         {
          "type": "a!agentChatField",
          "title": "Asistente de expedientes",
          "agent": "agent!EXP_ASISTENTE",
          "welcomeMessage": "Puedo buscar expedientes, resumir su historial y redactar un borrador del informe de tramitación para que usted lo revise.",
          "placeholder": "Pregunte por un expediente o pida un informe",
          "height": "TALL",
          "outputsSaveInto": [
           {
            "type": "a!save",
            "target": "local!borrador",
            "value": "save!value.informe"
           }
          ],
          "$replies": [
           {
            "text": "He redactado el **borrador del informe** del EXP-2026-0003 con los datos del expediente y su historial. Lo tiene a la derecha para revisarlo.",
            "tools": [
             {
              "tool": "Consultar expediente",
              "text": "EXP-2026-0003"
             },
             {
              "tool": "Redactar informe"
             }
            ],
            "outputs": {
             "informe": {
              "expediente": "EXP-2026-0003",
              "texto": "El expediente se tramitó en plazo. Consta la documentación requerida y el importe se ajusta al presupuesto aprobado."
             }
            }
           }
          ]
         }
        ]
       }
      ],
      "width": "AUTO"
     },
     {
      "type": "a!columnLayout",
      "contents": [
       {
        "type": "a!sectionLayout",
        "label": "Borrador propuesto",
        "labelSize": "MEDIUM",
        "labelHeadingTag": "H2",
        "labelColor": "STANDARD",
        "contents": [
         {
          "type": "a!cardLayout",
          "style": "STANDARD",
          "showBorder": false,
          "padding": "MORE",
          "shape": "SEMI_ROUNDED",
          "contents": [
           {
            "type": "a!richTextDisplayField",
            "labelPosition": "COLLAPSED",
            "align": "CENTER",
            "value": [
             {
              "type": "a!richTextIcon",
              "icon": "magic",
              "size": "LARGE",
              "color": "SECONDARY"
             },
             "\n",
             {
              "type": "a!richTextItem",
              "text": "Aún no hay borrador",
              "size": "MEDIUM_PLUS"
             },
             "\n",
             {
              "type": "a!richTextItem",
              "text": "Pida al asistente que redacte el informe de un expediente",
              "color": "SECONDARY"
             }
            ]
           }
          ],
          "showWhen": "a!isNullOrEmpty(local!borrador)"
         },
         {
          "type": "a!cardLayout",
          "style": "NONE",
          "showBorder": false,
          "showShadow": true,
          "shape": "SEMI_ROUNDED",
          "padding": "STANDARD",
          "contents": [
           {
            "type": "a!richTextDisplayField",
            "labelPosition": "COLLAPSED",
            "marginBelow": "LESS",
            "value": [
             {
              "type": "a!richTextIcon",
              "icon": "info-circle",
              "color": "SECONDARY"
             },
             " ",
             {
              "type": "a!richTextItem",
              "text": "Borrador generado con IA: revíselo antes de guardarlo",
              "color": "SECONDARY",
              "size": "SMALL"
             }
            ]
           },
           {
            "type": "a!textField",
            "label": "Expediente",
            "labelPosition": "ABOVE",
            "value": "{local!borrador.expediente}",
            "readOnly": true
           },
           {
            "type": "a!paragraphField",
            "label": "Informe",
            "value": "local!borrador.texto",
            "saveInto": "local!borrador.texto",
            "height": "MEDIUM"
           },
           {
            "type": "a!richTextDisplayField",
            "labelPosition": "COLLAPSED",
            "marginBelow": "STANDARD",
            "value": [
             {
              "type": "a!richTextItem",
              "text": "¿Le ha resultado útil?  ",
              "color": "SECONDARY",
              "size": "SMALL"
             },
             {
              "type": "a!richTextIcon",
              "icon": "thumbs-o-up",
              "color": "{if(local!valoracion = \"UTIL\", \"ACCENT\", \"SECONDARY\")}",
              "size": "MEDIUM",
              "altText": "Útil",
              "caption": "Útil",
              "link": {
               "type": "a!dynamicLink",
               "saveInto": [
                {
                 "type": "a!save",
                 "target": "local!valoracion",
                 "value": "UTIL"
                }
               ]
              }
             },
             "  ",
             {
              "type": "a!richTextIcon",
              "icon": "thumbs-o-down",
              "color": "{if(local!valoracion = \"NO_UTIL\", \"ACCENT\", \"SECONDARY\")}",
              "size": "MEDIUM",
              "altText": "No útil",
              "caption": "No útil",
              "link": {
               "type": "a!dynamicLink",
               "saveInto": [
                {
                 "type": "a!save",
                 "target": "local!valoracion",
                 "value": "NO_UTIL"
                }
               ]
              }
             },
             {
              "type": "a!richTextItem",
              "text": "   Gracias por su valoración",
              "color": "SECONDARY",
              "size": "SMALL",
              "showWhen": "a!isNotNullOrEmpty(local!valoracion)"
             }
            ]
           },
           {
            "type": "a!buttonArrayLayout",
            "align": "END",
            "marginBelow": "NONE",
            "buttons": [
             {
              "type": "a!buttonWidget",
              "label": "Descartar",
              "style": "OUTLINE",
              "color": "ACCENT",
              "$action": {
               "set": {
                "local!borrador": null
               }
              }
             },
             {
              "type": "a!buttonWidget",
              "label": "Guardar informe",
              "style": "SOLID",
              "color": "ACCENT"
             }
            ]
           }
          ],
          "showWhen": "a!isNotNullOrEmpty(local!borrador)"
         }
        ]
       }
      ],
      "width": "MEDIUM_PLUS"
     }
    ]
   }
  ]
 }
}