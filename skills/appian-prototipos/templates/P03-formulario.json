{
 "id": "formulario",
 "title": "Nuevo expediente (una página)",
 "type": "form",
 "pattern": "P03",
 "req": [
  "RF-ALTA"
 ],
 "$note": "P03: una columna estrecha (NARROW) con secciones H2; el botón repite el verbo del título; campos cortos en pareja; selección con explicación en cards; una acción SOLID.",
 "local": {
  "local!exp": {
   "titulo": null,
   "tipo": null,
   "unidad": null,
   "fecha": null,
   "descripcion": null,
   "docs": []
  }
 },
 "interface": {
  "type": "a!formLayout",
  "titleBar": "Nuevo expediente",
  "contentsWidth": "NARROW",
  "backgroundColor": "WHITE",
  "showButtonDivider": true,
  "contents": [
   {
    "type": "a!sectionLayout",
    "label": "Datos generales",
    "labelSize": "MEDIUM",
    "labelHeadingTag": "H2",
    "labelColor": "STANDARD",
    "contents": [
     {
      "type": "a!textField",
      "label": "Título",
      "value": "local!exp.titulo",
      "saveInto": "local!exp.titulo",
      "required": true,
      "requiredMessage": "Indique un título",
      "characterLimit": 200
     },
     {
      "type": "a!cardChoiceField",
      "label": "Tipo",
      "data": [
       {
        "id": "Obra",
        "texto": "Obra",
        "detalle": "Construcción, reforma o reparación",
        "icono": "building"
       },
       {
        "id": "Servicio",
        "texto": "Servicio",
        "detalle": "Mantenimiento, limpieza o asistencia",
        "icono": "wrench"
       },
       {
        "id": "Suministro",
        "texto": "Suministro",
        "detalle": "Compra de equipos o materiales",
        "icono": "truck"
       }
      ],
      "cardTemplate": {
       "type": "a!cardTemplateBarTextStacked",
       "id": "fv!data.id",
       "primaryText": "{fv!data.texto}",
       "icon": "{fv!data.icono}",
       "secondaryText": "{fv!data.detalle}"
      },
      "value": "local!exp.tipo",
      "saveInto": "local!exp.tipo",
      "maxSelections": 1,
      "required": true
     },
     {
      "type": "a!columnsLayout",
      "columns": [
       {
        "type": "a!columnLayout",
        "contents": [
         {
          "type": "a!dropdownField",
          "label": "Unidad",
          "placeholder": "Seleccione",
          "choiceLabels": [
           "NOR",
           "SUR",
           "EST",
           "OES",
           "SSCC"
          ],
          "choiceValues": [
           "NOR",
           "SUR",
           "EST",
           "OES",
           "SSCC"
          ],
          "value": "local!exp.unidad",
          "saveInto": "local!exp.unidad",
          "required": true
         }
        ]
       },
       {
        "type": "a!columnLayout",
        "contents": [
         {
          "type": "a!dateField",
          "label": "Fecha de inicio",
          "value": "local!exp.fecha",
          "saveInto": "local!exp.fecha",
          "required": true
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "a!sectionLayout",
    "label": "Detalle",
    "labelSize": "MEDIUM",
    "labelHeadingTag": "H2",
    "labelColor": "STANDARD",
    "marginBelow": "NONE",
    "contents": [
     {
      "type": "a!paragraphField",
      "label": "Descripción",
      "value": "local!exp.descripcion",
      "saveInto": "local!exp.descripcion",
      "height": "MEDIUM",
      "instructions": "Qué se solicita y por qué",
      "characterLimit": 2000,
      "showCharacterCount": true
     },
     {
      "type": "a!fileUploadField",
      "label": "Documentación",
      "value": "local!exp.docs",
      "saveInto": "local!exp.docs",
      "maxSelections": 5,
      "instructions": "PDF o DOCX, máximo 10 MB por fichero"
     }
    ]
   }
  ],
  "buttons": {
   "type": "a!buttonLayout",
   "primaryButtons": [
    {
     "type": "a!buttonWidget",
     "label": "Crear expediente",
     "style": "SOLID",
     "color": "ACCENT",
     "$action": {
      "goto": "listado"
     },
     "submit": true
    }
   ],
   "secondaryButtons": [
    {
     "type": "a!buttonWidget",
     "label": "Cancelar",
     "style": "OUTLINE",
     "color": "ACCENT",
     "$action": {
      "goto": "listado"
     }
    }
   ]
  }
 }
}