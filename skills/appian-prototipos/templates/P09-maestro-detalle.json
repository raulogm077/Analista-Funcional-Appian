{
 "id": "maestro",
 "title": "Bandeja de revisión",
 "type": "page",
 "pattern": "P09",
 "req": [
  "RF-APROB"
 ],
 "$note": "P09: lista a la izquierda con fila resaltada (una selección, la primera seleccionada al entrar) y detalle al lado; la acción principal en el detalle. Si el detalle no cabe al lado, drilldown (bloques.md).",
 "local": {
  "local!sel": [
   2
  ]
 },
 "interface": {
  "type": "a!headerContentLayout",
  "backgroundColor": "TRANSPARENT",
  "contents": [
   {
    "type": "a!columnsLayout",
    "alignVertical": "MIDDLE",
    "marginBelow": "MORE",
    "columns": [
     {
      "type": "a!columnLayout",
      "contents": [
       {
        "type": "a!headingField",
        "text": "Bandeja de revisión",
        "size": "LARGE",
        "headingTag": "H1",
        "marginBelow": "EVEN_LESS"
       },
       {
        "type": "a!richTextDisplayField",
        "labelPosition": "COLLAPSED",
        "value": [
         {
          "type": "a!richTextItem",
          "text": "Expedientes pendientes de su aprobación, uno tras otro",
          "color": "SECONDARY"
         }
        ],
        "marginBelow": "NONE"
       }
      ]
     }
    ]
   },
   {
    "type": "a!columnsLayout",
    "stackWhen": [
     "PHONE",
     "TABLET_PORTRAIT"
    ],
    "columns": [
     {
      "type": "a!columnLayout",
      "contents": [
       {
        "type": "a!cardLayout",
        "style": "NONE",
        "showBorder": false,
        "showShadow": true,
        "shape": "SEMI_ROUNDED",
        "padding": "STANDARD",
        "contents": [
         {
          "type": "a!gridField",
          "labelPosition": "COLLAPSED",
          "data": "recordType!EXP Expediente",
          "borderStyle": "LIGHT",
          "shadeAlternateRows": false,
          "spacing": "STANDARD",
          "pageSize": 8,
          "rowHeader": 1,
          "emptyGridMessage": "No tiene expedientes pendientes",
          "columns": [
           {
            "type": "a!gridColumn",
            "label": "Expediente",
            "value": {
             "type": "a!richTextDisplayField",
             "labelPosition": "COLLAPSED",
             "value": [
              {
               "type": "a!richTextItem",
               "text": "{fv!row.codigo}",
               "style": "STRONG"
              },
              "\n",
              {
               "type": "a!richTextItem",
               "text": "{fv!row.titulo}",
               "color": "SECONDARY",
               "size": "SMALL"
              }
             ]
            }
           },
           {
            "type": "a!gridColumn",
            "label": "Recibido",
            "value": "{fv!row.fechaEnvio|date}",
            "width": "NARROW"
           },
           {
            "type": "a!gridColumn",
            "label": "Importe",
            "value": "{fv!row.importe|eur|dash}",
            "align": "END",
            "width": "NARROW_PLUS"
           }
          ],
          "$filter": "fv!row.estado = \"Pendiente de aprobación\"",
          "selectable": true,
          "selectionStyle": "ROW_HIGHLIGHT",
          "maxSelections": 1,
          "selectionValue": "local!sel",
          "selectionSaveInto": "local!sel"
         }
        ]
       }
      ]
     },
     {
      "type": "a!columnLayout",
      "width": "MEDIUM_PLUS",
      "contents": [
       {
        "type": "a!cardLayout",
        "style": "NONE",
        "showBorder": false,
        "showShadow": true,
        "shape": "SEMI_ROUNDED",
        "padding": "STANDARD",
        "contents": [
         {
          "type": "a!forEach",
          "items": "recordType!EXP Expediente",
          "$filter": "fv!item.id = index(local!sel, 1, null)",
          "expression": {
           "type": "a!sectionLayout",
           "marginBelow": "NONE",
           "contents": [
            {
             "type": "a!sectionLayout",
             "label": "{fv!item.codigo}",
             "labelSize": "SMALL",
             "labelHeadingTag": "H3",
             "labelColor": "SECONDARY",
             "marginBelow": "STANDARD",
             "contents": [
              {
               "type": "a!richTextDisplayField",
               "labelPosition": "COLLAPSED",
               "value": [
                {
                 "type": "a!richTextItem",
                 "text": "{fv!item.titulo}",
                 "style": "STRONG"
                },
                "\n",
                {
                 "type": "a!richTextItem",
                 "text": "{fv!item.tipo} · {fv!item.unidad} · recibido el {fv!item.fechaEnvio|date}",
                 "color": "SECONDARY",
                 "size": "SMALL"
                }
               ]
              },
              {
               "type": "a!tagField",
               "labelPosition": "COLLAPSED",
               "size": "SMALL",
               "tags": [
                {
                 "type": "a!tagItem",
                 "text": "{fv!item.estado}",
                 "backgroundColor": "{fv!item.estado|map:estadoColor}"
                }
               ]
              }
             ]
            },
            {
             "type": "a!columnsLayout",
             "marginBelow": "STANDARD",
             "columns": [
              {
               "type": "a!columnLayout",
               "contents": [
                {
                 "type": "a!richTextDisplayField",
                 "label": "Responsable",
                 "labelPosition": "COLLAPSED",
                 "value": [
                  {
                   "type": "a!richTextItem",
                   "text": "Responsable",
                   "color": "SECONDARY",
                   "size": "SMALL"
                  },
                  "\n",
                  {
                   "type": "a!richTextItem",
                   "text": "{fv!item.responsable|dash}",
                   "size": "MEDIUM"
                  }
                 ],
                 "marginBelow": "NONE"
                }
               ]
              },
              {
               "type": "a!columnLayout",
               "contents": [
                {
                 "type": "a!richTextDisplayField",
                 "label": "Importe",
                 "labelPosition": "COLLAPSED",
                 "value": [
                  {
                   "type": "a!richTextItem",
                   "text": "Importe",
                   "color": "SECONDARY",
                   "size": "SMALL"
                  },
                  "\n",
                  {
                   "type": "a!richTextItem",
                   "text": "{fv!item.importe|eur|dash}",
                   "size": "MEDIUM"
                  }
                 ],
                 "marginBelow": "NONE"
                }
               ]
              }
             ]
            },
            {
             "type": "a!richTextDisplayField",
             "label": "Descripción",
             "labelPosition": "COLLAPSED",
             "value": [
              {
               "type": "a!richTextItem",
               "text": "Descripción",
               "color": "SECONDARY",
               "size": "SMALL"
              },
              "\n",
              {
               "type": "a!richTextItem",
               "text": "{fv!item.descripcion|dash}",
               "size": "MEDIUM"
              }
             ],
             "marginBelow": "STANDARD"
            },
            {
             "type": "a!buttonArrayLayout",
             "align": "END",
             "marginBelow": "NONE",
             "buttons": [
              {
               "type": "a!buttonWidget",
               "label": "Abrir ficha",
               "style": "OUTLINE",
               "color": "ACCENT",
               "$action": {
                "goto": "registro",
                "params": {
                 "id": "{fv!item.id}"
                }
               }
              },
              {
               "type": "a!buttonWidget",
               "label": "Revisar",
               "style": "SOLID",
               "color": "ACCENT",
               "$action": {
                "goto": "tarea",
                "params": {
                 "id": "{fv!item.id}"
                }
               }
              }
             ]
            }
           ]
          }
         },
         {
          "type": "a!richTextDisplayField",
          "labelPosition": "COLLAPSED",
          "value": [
           {
            "type": "a!richTextItem",
            "text": "Seleccione una fila para ver el detalle",
            "style": "EMPHASIS",
            "color": "SECONDARY"
           }
          ],
          "showWhen": "a!isNullOrEmpty(local!sel)"
         }
        ]
       }
      ]
     }
    ]
   }
  ]
 }
}